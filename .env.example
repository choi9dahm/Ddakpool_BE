PORT=4000
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PARSE_TIMEOUT_MS=30000
# Playwright 폴백은 기본 비활성(사람인/잡코리아 headless 차단). 필요 시 true
PARSE_USE_PLAYWRIGHT=false
PLAYWRIGHT_HEADLESS=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5-nano
LLM_FALLBACK_MODEL=gpt-5-mini
