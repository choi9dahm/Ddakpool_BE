PORT=4000
# 쉼표로 여러 origin 허용 (예: 로컬 + Vercel 프로덕션)
CORS_ORIGIN=http://localhost:3000,https://pm6-final-group-10-fe.vercel.app
# true면 *.vercel.app 도메인도 허용 (프리뷰 배포용)
CORS_ALLOW_VERCEL=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PARSE_TIMEOUT_MS=30000
# Playwright 폴백은 기본 비활성(사람인/잡코리아 headless 차단). 필요 시 true
PARSE_USE_PLAYWRIGHT=false
PLAYWRIGHT_HEADLESS=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5-nano
LLM_FALLBACK_MODEL=gpt-5-mini
